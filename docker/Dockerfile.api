FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN corepack enable && pnpm install --frozen-lockfile

RUN pnpm --filter @agentic-os/types build
RUN pnpm --filter @agentic-os/api build
RUN pnpm --filter @agentic-os/api deploy --prod /prod/api

FROM node:20-alpine AS runner

WORKDIR /app

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

COPY --from=builder --chown=nodejs:nodejs /prod/api ./
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/drizzle ./drizzle

USER nodejs

EXPOSE 3001

CMD ["node", "dist/index.js"]
