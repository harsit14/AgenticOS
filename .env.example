# Agentic Control Tower - Environment Variables

# Database
DATABASE_URL=file:./data/agentic.db

# API Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Authentication (Phase 1 - simple)
# JWT_SECRET should be a long random string
JWT_SECRET=your-secret-key-here-change-in-production

# LLM Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
VERTEX_AI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GROQ_API_KEY=
PERPLEXITY_API_KEY=
MISTRAL_API_KEY=

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Local LLM (LM Studio)
LM_STUDIO_BASE_URL=http://localhost:1234

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentic-control-tower
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Budget Alerts
DEFAULT_BUDGET_LIMIT=100
DEFAULT_BUDGET_ALERT_THRESHOLD=0.8