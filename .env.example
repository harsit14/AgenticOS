# Agentic Control Tower - Environment Variables (local-first)

# SQLite database file (relative to apps/api working directory)
DATABASE_URL=file:./data/agentic.db

# API Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Local LLM endpoints (provider API keys live in the settings store, not env)
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentic-control-tower

# Rate Limiting (in-process)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000